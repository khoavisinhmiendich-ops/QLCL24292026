# Neon / Vercel Postgres (pooled connection string)
DATABASE_URL=
# Chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -base64 48
AUTH_SECRET=
# Vercel Blob (lưu file tài liệu gốc + bản xem trước PDF)
BLOB_READ_WRITE_TOKEN=
# Khóa API cho AI Assistant (giai đoạn sau)
AI_API_KEY=
# Dùng cho script seed:admin (đặt tạm khi chạy, không commit)
ADMIN_USERNAME=
ADMIN_PASSKEY=
# Mô hình AI (mặc định claude-sonnet-5-5)
AI_MODEL=
# Bí mật cho sao lưu tự động hằng ngày (Vercel Cron): openssl rand -base64 32
CRON_SECRET=
